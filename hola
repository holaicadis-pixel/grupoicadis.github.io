<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Portal Oficial | Grupo ICADIS</title>

<style>
/* =========================
   ESTILO GENERAL
========================= */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Arial", sans-serif;
}

body {
  background: #eef2f6;
  color: #1c1c1c;
}

/* =========================
   BARRA SUPERIOR
========================= */
.topbar {
  background: #0b1f3a;
  color: white;
  padding: 8px 20px;
  font-size: 12px;
  display: flex;
  justify-content: space-between;
}

/* =========================
   HEADER PRINCIPAL
========================= */
header {
  background: white;
  padding: 18px 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 3px solid #0b1f3a;
}

.logo {
  font-weight: bold;
  font-size: 18px;
  color: #0b1f3a;
  letter-spacing: 1px;
}

nav a {
  margin-left: 18px;
  text-decoration: none;
  color: #0b1f3a;
  font-size: 14px;
}

nav a:hover {
  color: #0077cc;
}

/* =========================
   HERO PORTAL
========================= */
.hero {
  background: linear-gradient(rgba(11,31,58,0.85), rgba(11,31,58,0.85)),
              url('https://images.unsplash.com/photo-1520607162513-77705c0f0d4a') center/cover;
  height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: white;
  padding: 20px;
}

.hero-box {
  max-width: 700px;
}

.hero h1 {
  font-size: 34px;
  margin-bottom: 10px;
}

.hero p {
  font-size: 15px;
  opacity: 0.9;
  line-height: 1.5;
}

/* =========================
   BOTÓN OFICIAL
========================= */
.btn {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 22px;
  background: #00a86b;
  color: white;
  text-decoration: none;
  border-radius: 4px;
  font-weight: bold;
}

.btn:hover {
  background: #018f5a;
}

/* =========================
   SECCIÓN INFO
========================= */
.section {
  padding: 50px 20px;
  text-align: center;
}

.section h2 {
  color: #0b1f3a;
  margin-bottom: 10px;
}

.section p {
  max-width: 750px;
  margin: auto;
  font-size: 14px;
  line-height: 1.6;
  color: #444;
}

/* =========================
   FOOTER
========================= */
footer {
  background: #0b1f3a;
  color: white;
  text-align: center;
  padding: 15px;
  font-size: 12px;
  margin-top: 40px;
}
</style>
</head>

<body>

<!-- BARRA SUPERIOR -->
<div class="topbar">
  <div>Portal Oficial de Validación ICADIS</div>
  <div>Soporte: contacto@icadis.com</div>
</div>

<!-- HEADER -->
<header>
  <div class="logo">GRUPO ICADIS</div>
  <nav>
    <a href="#">Inicio</a>
    <a href="#info">Información</a>
    <a href="validacion.html">Validar Constancia</a>
  </nav>
</header>

<!-- HERO -->
<section class="hero">
  <div class="hero-box">
    <h1>Portal Oficial de Certificación</h1>
    <p>
      Sistema institucional para la validación de constancias, cursos y certificaciones emitidas por Grupo ICADIS.
    </p>

    <a href="validacion.html" class="btn">Ingresar a Validación</a>
  </div>
</section>

<!-- INFO -->
<section class="section" id="info">
  <h2>Validación Segura</h2>
  <p>
    Este portal permite consultar la autenticidad de documentos emitidos por nuestra institución.
    Cada registro es verificado de forma segura y confiable.
  </p>
</section>

<!-- FOOTER -->
<footer>
  © 2026 Grupo ICADIS - Portal Oficial de Certificación
</footer>

</body>
</html>
